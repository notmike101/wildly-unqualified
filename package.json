{
  "name": "wildly-unqualified",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=26.5.0 <27"
  },
  "scripts": {
    "dev": "vite --config vite.config.ts",
    "build": "npm run typecheck && vite build --config vite.config.ts",
    "start": "node src/server/server.ts",
    "test": "node --test \"tests/**/*.test.ts\"",
    "test:browser": "node tests/e2e/browser.ts",
    "release": "node scripts/release.ts",
    "release:desktop": "npm run build && node scripts/release-desktop.ts",
    "format": "prettier --write \"*.{ts,mjs,html,css,json}\" \"{src,tests,scripts}/**/*.{ts,css,json}\"",
    "format:check": "prettier --check \"*.{ts,mjs,html,css,json}\" \"{src,tests,scripts}/**/*.{ts,css,json}\"",
    "lint": "eslint . --max-warnings 0",
    "wu:dev": "npm run dev",
    "wu:build": "npm run build",
    "wu:serve": "npm start",
    "wu:test": "npm test",
    "wu:test:browser": "npm run test:browser",
    "wu:release": "npm run release",
    "wu:format": "npm run format",
    "wu:format:check": "npm run format:check",
    "typecheck": "node node_modules/typescript-native/bin/tsc --noEmit"
  },
  "dependencies": {
    "box3d-wasm": "0.2.0",
    "three": "0.185.1",
    "ws": "8.21.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@types/node": "26.0.0",
    "@types/three": "0.185.4",
    "@types/ws": "8.18.1",
    "eslint": "10.10.0",
    "eslint-plugin-jsdoc": "64.3.6",
    "eslint-plugin-unicorn": "^74.0.0",
    "globals": "^17.12.0",
    "gltf-validator": "2.0.0-dev.3.10",
    "playwright": "1.63.0",
    "prettier": "3.9.6",
    "typescript": "6.0.3",
    "typescript-eslint": "^8.69.0",
    "typescript-native": "npm:typescript@7.0.2",
    "vite": "8.2.2"
  }
}
