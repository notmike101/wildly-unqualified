{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "strict": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "skipLibCheck": true,
    "types": ["node", "vite/client"],
    "erasableSyntaxOnly": true
  },
  "include": ["*.ts"],
  "exclude": ["web", "web-mvp", "data", "node_modules", ".worktrees"]
}
