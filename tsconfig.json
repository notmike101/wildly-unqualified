{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2023", "ES2025.Iterator", "DOM", "DOM.Iterable"],
    "strict": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "skipLibCheck": true,
    "types": ["node", "vite/client"],
    "erasableSyntaxOnly": true
  },
  "include": [
    "src/**/*.ts",
    "tests/**/*.ts",
    "scripts/**/*.ts",
    "vite.config.ts"
  ],
  "exclude": [
    "dist",
    "web",
    "web-mvp",
    "data",
    "data-expedition",
    "node_modules",
    ".worktrees",
    ".artifacts"
  ]
}
